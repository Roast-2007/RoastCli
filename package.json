{
  "name": "roastcli",
  "version": "0.6.0",
  "description": "A terminal coding agent with multiple providers, context recall and collaborative agents",
  "license": "MIT",
  "author": "Roast-2007",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Roast-2007/RoastCli.git"
  },
  "homepage": "https://github.com/Roast-2007/RoastCli#readme",
  "bugs": {
    "url": "https://github.com/Roast-2007/RoastCli/issues"
  },
  "files": ["dist", "docs/USAGE.md", "LICENSE"],
  "keywords": ["cli", "coding-agent", "tui", "ai", "mcp"],
  "type": "module",
  "bin": {
    "roast": "./dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/entrypoints/cli.ts",
    "build": "tsdown",
    "prepack": "npm run build",
    "check:package": "node scripts/check-package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src test scripts",
    "format": "biome format --write src test scripts",
    "format:check": "biome format src test scripts"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@vscode/ripgrep": "1.18.0",
    "cli-highlight": "2.1.11",
    "commander": "^14.0.0",
    "diff": "9.0.0",
    "ink": "7.1.1",
    "marked": "18.0.14",
    "picomatch": "4.0.7",
    "react": "19.3.0",
    "tinyglobby": "0.2.17",
    "turndown": "7.2.4",
    "typescript": "^5.9.2",
    "yaml": "2.9.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/node": "^24.3.0",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitest/coverage-v8": "3.2.7",
    "ink-testing-library": "4.0.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.20.3",
    "vitest": "^3.2.4"
  }
}
