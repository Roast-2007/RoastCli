{
  "$schema": "https://biomejs.dev/schemas/2.4.0/schema.json",
  "files": { "includes": ["src/**", "test/**", "scripts/**"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 140 },
  "javascript": { "formatter": { "quoteStyle": "single", "semicolons": "always" } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": { "noUnreachable": "error", "noUnsafeFinally": "error" },
      "suspicious": { "noDebugger": "error", "noDuplicateCase": "error", "noDuplicateObjectKeys": "error" }
    }
  }
}
