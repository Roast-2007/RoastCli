{
  "$schema": "复制为 roastcli.config.json 后运行 roast config 输入 API Key。密钥存用户 credentials.json，配置只记录引用。",
  "providers": {
    "deepseek": {
      "driver": "openai-compat",
      "baseURL": "https://api.deepseek.com",
      "models": {
        "deepseek-chat": { "contextWindow": 131072, "maxTokens": 8192 },
        "deepseek-reasoner": { "contextWindow": 131072, "maxTokens": 8192, "reasoning": true }
      }
    },
    "openai": {
      "driver": "openai-compat",
      "baseURL": "https://api.openai.com/v1"
    },
    "claude": {
      "driver": "anthropic",
      "baseURL": "https://api.anthropic.com",
      "models": {
        "claude-sonnet-4-5": { "contextWindow": 200000, "maxTokens": 8192 }
      }
    },
    "kimi-code": {
      "driver": "openai-compat",
      "baseURL": "https://api.kimi.com/coding/v1",
      "models": {
        "kimi-for-coding": { "contextWindow": 1048576, "reasoningEffort": "high", "reasoningReplay": "field" }
      }
    },
    "local": {
      "driver": "openai-compat",
      "baseURL": "http://localhost:1234/v1",
      "auth": "none",
      "models": {
        "local-model-a": { "contextWindow": 32768 },
        "local-model-b": { "reasoningEfforts": ["low", "high"] }
      }
    }
  },
  "default": "deepseek:deepseek-chat",
  "maxSteps": 50,
  "logsDir": "logs",
  "context": { "summaryModel": "auto", "summaryMaxTokens": 2048 },
  "webSearch": { "driver": "duckduckgo", "timeoutMs": 30000 },
  "ui": { "theme": "ember", "shellTimeoutMs": 600000, "markdown": { "padding": 2, "spacing": 1 } },
  "swarm": {
    "models": { "worker": "deepseek:deepseek-chat", "scout": "inherit" },
    "efforts": { "worker": null }
  }
}
